# SMTP для отправки заявок с сайта
# Яндекс: создайте пароль приложения на id.yandex.ru → Безопасность → Пароли приложений
SMTP_USER=your@yandex.ru
SMTP_PASS=your_app_password
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SECURE=true

# Куда приходят заявки (можно тот же адрес что и SMTP_USER)
MAIL_TO=your@yandex.ru
